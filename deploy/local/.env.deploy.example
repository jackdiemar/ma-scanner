# MA Scanner — VPS Deploy Configuration
# Copy this file to deploy/local/.env.deploy and fill in your values.
#
#   cp deploy/local/.env.deploy.example deploy/local/.env.deploy
#
# .env.deploy is gitignored — never commit it.

MA_SCANNER_VPS_HOST=root@your_server_ip
MA_SCANNER_REMOTE_DIR=/opt/ma-scanner
MA_SCANNER_BRANCH=ai-final
