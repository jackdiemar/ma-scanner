# Copy to config/.env on the VPS or local runtime.
# Do not commit real values. Keep config/.env chmod 600.
FMP_API_KEY=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=
EMAIL_RECIPIENT=
EMAIL_ALERTS_ENABLED=false
EMAIL_ON_EVERY_RUN=false
EMAIL_ON_NEW_ALERTS=true
EMAIL_DAILY_DIGEST=true

# SMTP fallback. Some VPS providers block outbound SMTP ports.
SMTP_USER=
SMTP_PASSWORD=
SMTP_RECIPIENT=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=

# Legacy/local aliases used by older helpers or dashboard tooling. Leave blank
# unless a specific script asks for them.
SMTP_RECIPIENTS=
SENDER_EMAIL=
SENDER_PASSWORD=
RECIPIENT_EMAIL=
BSC_DASHBOARD_USERS={"admin":"pbkdf2_sha256$260000$salt_hex$digest_hex"}
PORT=8000

# AI Research Layer
# The AI layer is fully optional. The live scanner never depends on these vars.
# Set AI_RESEARCH_ENABLED=true and provide an API key to enable LLM-powered research gating.
AI_RESEARCH_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_RESEARCH_MAX_CASES_PER_RUN=5
AI_RESEARCH_DEFAULT_DEPTH=fast_gate
AI_RESEARCH_DRY_RUN=true

# AI Email Settings (separate from scanner alert emails)
# Uses EMAIL_PROVIDER / RESEND_API_KEY / RESEND_FROM / EMAIL_RECIPIENT above.
AI_EMAILS_ENABLED=false
AI_EMAIL_ON_EVERY_RUN=false
AI_EMAIL_SUBJECT_PREFIX=MA Scanner AI Brief

# Opportunity selection / suppression controls
# AI_EMAIL_SUPPRESS_REPEATED_DISCARDS: true = run in opportunity mode (suppress repeated DISCARDs)
# AI_EMAIL_SEND_NO_OPPORTUNITY_DIGEST: true = send email even when all cases are suppressed
# AI_EMAIL_MAX_SUPPRESSED_SUMMARY: max suppressed cases shown in email archive section
AI_EMAIL_SUPPRESS_REPEATED_DISCARDS=true
AI_EMAIL_SEND_NO_OPPORTUNITY_DIGEST=true
AI_EMAIL_MAX_SUPPRESSED_SUMMARY=5
