#!/usr/bin/env python3
"""
send_alert.py - Email alerts for high-scoring stocks
Usage: python3 send_alert.py <scan_file> <email> <threshold>
"""

import sys
import json
import smtplib
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart
from datetime import datetime
from secure_config import get_env

# ===== EMAIL CONFIGURATION =====
# Option 1: Gmail (recommended for testing)
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USERNAME = get_env("SMTP_USER")
SMTP_PASSWORD = get_env("SMTP_PASSWORD")

# Option 2: SendGrid (for production)
# SMTP_SERVER = "smtp.sendgrid.net"
# SMTP_PORT = 587
# SMTP_USERNAME = "apikey"
# SMTP_PASSWORD = get_env("SMTP_PASSWORD")

# ===== FUNCTIONS =====

def load_scan_results(scan_file):
    """Load scan results from JSON file"""
    try:
        with open(scan_file, 'r') as f:
            return json.load(f)
    except Exception as e:
        print(f"Error loading scan file: {e}")
        sys.exit(1)

def find_high_scores(results, threshold):
    """Find stocks with scores >= threshold"""
    high_scores = []
    
    for ticker, data in results.get('results', {}).items():
        score = data.get('score', 0)
        if score >= threshold:
            high_scores.append({
                'ticker': ticker,
                'score': score,
                'signals': data.get('signals', [])[:5],  # Top 5 signals
                'has_sec': data.get('has_sec', False)
            })
    
    # Sort by score descending
    high_scores.sort(key=lambda x: x['score'], reverse=True)
    return high_scores

def format_email_body(high_scores, scan_date):
    """Format email body with stock details"""
    
    if not high_scores:
        return None
    
    html = f"""
    <html>
    <head>
        <style>
            body {{ font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }}
            .container {{ max-width: 600px; margin: 0 auto; padding: 20px; }}
            .header {{ background: #1a1a1a; color: #fff; padding: 20px; text-align: center; }}
            .logo {{ font-family: Georgia, serif; font-size: 32px; letter-spacing: -1px; }}
            .alert {{ background: #00ff88; color: #000; padding: 10px; text-align: center; font-weight: bold; }}
            .stock-card {{ background: #f9f9f9; border: 1px solid #e0e0e0; border-radius: 4px; padding: 20px; margin: 15px 0; }}
            .stock-header {{ display: flex; justify-content: space-between; margin-bottom: 15px; }}
            .ticker {{ font-size: 24px; font-weight: bold; }}
            .score {{ font-size: 32px; color: #00ff88; font-weight: bold; }}
            .signal {{ font-size: 13px; color: #666; padding: 5px 0; border-bottom: 1px solid #e0e0e0; }}
            .footer {{ text-align: center; color: #999; font-size: 12px; margin-top: 30px; }}
        </style>
    </head>
    <body>
        <div class="container">
            <div class="header">
                <div class="logo">bsc</div>
                <div>Black Starlight Capital</div>
            </div>
            
            <div class="alert">
                🚨 BUY SIGNALS DETECTED - {len(high_scores)} Stock{'s' if len(high_scores) != 1 else ''}
            </div>
            
            <p>Daily scan completed on {scan_date}</p>
            <p>The following stocks scored 85+ and show high M&A probability:</p>
    """
    
    for stock in high_scores:
        sec_badge = "✓ SEC Activity" if stock['has_sec'] else ""
        
        html += f"""
            <div class="stock-card">
                <div class="stock-header">
                    <div class="ticker">{stock['ticker']} {sec_badge}</div>
                    <div class="score">{stock['score']:.1f}</div>
                </div>
                <div><strong>Top Signals:</strong></div>
        """
        
        for signal in stock['signals']:
            signal_type = signal.get('type', 'Signal')
            signal_pts = signal.get('pts', 0)
            html += f'<div class="signal">• {signal_type} (+{signal_pts:.1f} pts)</div>'
        
        html += """
            </div>
        """
    
    html += """
            <div class="footer">
                <p>Black Starlight Capital - M&A Intelligence Platform</p>
                <p>This is an automated alert. Do not reply to this email.</p>
            </div>
        </div>
    </body>
    </html>
    """
    
    return html

def format_daily_report(top_10, total_stocks, avg_score, scan_date):
    """Format daily summary report email"""
    
    html = f"""
    <html>
    <head>
        <style>
            body {{ font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }}
            .container {{ max-width: 600px; margin: 0 auto; padding: 20px; }}
            .header {{ background: #1a1a1a; color: #fff; padding: 20px; text-align: center; }}
            .logo {{ font-family: Georgia, serif; font-size: 32px; letter-spacing: -1px; }}
            .summary {{ background: #f9f9f9; border: 1px solid #e0e0e0; border-radius: 4px; padding: 20px; margin: 20px 0; }}
            .stat-row {{ display: flex; justify-content: space-around; margin: 20px 0; }}
            .stat {{ text-align: center; }}
            .stat-value {{ font-size: 32px; font-weight: bold; color: #1a1a1a; }}
            .stat-label {{ font-size: 12px; color: #666; text-transform: uppercase; }}
            .stock-list {{ background: #fff; border: 1px solid #e0e0e0; border-radius: 4px; padding: 15px; margin: 15px 0; }}
            .stock-item {{ display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f0f0f0; }}
            .stock-item:last-child {{ border-bottom: none; }}
            .ticker {{ font-weight: bold; font-size: 14px; }}
            .score {{ font-size: 16px; color: #666; }}
            .footer {{ text-align: center; color: #999; font-size: 12px; margin-top: 30px; }}
        </style>
    </head>
    <body>
        <div class="container">
            <div class="header">
                <div class="logo">bsc</div>
                <div>Black Starlight Capital</div>
            </div>
            
            <h2 style="margin: 20px 0;">Daily Scan Report</h2>
            <p style="color: #666;">{scan_date}</p>
            
            <div class="summary">
                <div class="stat-row">
                    <div class="stat">
                        <div class="stat-value">{total_stocks}</div>
                        <div class="stat-label">Stocks Scanned</div>
                    </div>
                    <div class="stat">
                        <div class="stat-value">{avg_score:.1f}</div>
                        <div class="stat-label">Avg Score</div>
                    </div>
                </div>
                <p style="text-align: center; color: #666; margin-top: 10px;">
                    ✓ No buy signals detected (score &lt; 85)
                </p>
            </div>
            
            <h3 style="margin: 20px 0;">Top 10 Stocks</h3>
            <div class="stock-list">
    """
    
    for ticker, data in top_10:
        score = data.get('score', 0)
        signals = data.get('signals', [])
        top_signal = signals[0].get('type', 'N/A') if signals else 'N/A'
        
        html += f"""
            <div class="stock-item">
                <div>
                    <span class="ticker">{ticker}</span>
                    <div style="font-size: 11px; color: #999;">{top_signal}</div>
                </div>
                <div class="score">{score:.1f}</div>
            </div>
        """
    
    html += """
            </div>
            
            <div class="footer">
                <p>Black Starlight Capital - M&A Intelligence Platform</p>
                <p>This is an automated daily report. Do not reply to this email.</p>
            </div>
        </div>
    </body>
    </html>
    """
    
    return html

def send_email(to_email, subject, html_body):
    """Send email via SMTP"""
    try:
        # Create message
        msg = MIMEMultipart('alternative')
        msg['Subject'] = subject
        msg['From'] = SMTP_USERNAME
        msg['To'] = to_email
        
        # Attach HTML body
        html_part = MIMEText(html_body, 'html')
        msg.attach(html_part)
        
        # Send email
        with smtplib.SMTP(SMTP_SERVER, SMTP_PORT) as server:
            server.starttls()
            server.login(SMTP_USERNAME, SMTP_PASSWORD)
            server.send_message(msg)
        
        print(f"✓ Alert email sent to {to_email}")
        return True
        
    except Exception as e:
        print(f"✗ Error sending email: {e}")
        return False

# ===== MAIN =====

def main():
    if len(sys.argv) != 4:
        print("Usage: python3 send_alert.py <scan_file> <email> <threshold>")
        sys.exit(1)
    
    scan_file = sys.argv[1]
    alert_email = sys.argv[2]
    threshold = float(sys.argv[3])
    
    # Load scan results
    scan_data = load_scan_results(scan_file)
    scan_date = datetime.now().strftime("%B %d, %Y at %I:%M %p")
    
    # Find high-scoring stocks
    high_scores = find_high_scores(scan_data, threshold)
    
    # Get all results for daily summary
    all_results = scan_data.get('results', {})
    total_stocks = len(all_results)
    avg_score = sum(d.get('score', 0) for d in all_results.values()) / total_stocks if total_stocks > 0 else 0
    
    # Get top 10 for daily report
    top_10 = sorted(
        [(ticker, data) for ticker, data in all_results.items()],
        key=lambda x: x[1].get('score', 0),
        reverse=True
    )[:10]
    
    if high_scores:
        # ALERT: High scores found
        print(f"Found {len(high_scores)} stocks with score >= {threshold}")
        for stock in high_scores:
            print(f"  • {stock['ticker']}: {stock['score']:.1f}")
        
        html_body = format_email_body(high_scores, scan_date)
        subject = f"🚨 BSC Alert: {len(high_scores)} Buy Signal{'s' if len(high_scores) != 1 else ''} Detected"
    else:
        # DAILY REPORT: No high scores, send summary
        print(f"No stocks scored >= {threshold}. Sending daily summary report.")
        html_body = format_daily_report(top_10, total_stocks, avg_score, scan_date)
        subject = f"📊 BSC Daily Report - {datetime.now().strftime('%b %d, %Y')}"
    
    send_email(alert_email, subject, html_body)

if __name__ == "__main__":
    main()
