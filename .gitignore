.env
.env.*
!.env.example
config/.env
config/.env.*
!config/.env.example
.venv/
__pycache__/
*.pyc
*.log
*.db
*.sqlite
logs/
.DS_Store
# Large media files — not suitable for git
*.mov
*.mp4
*.avi
assets/media/

# FMP / EDGAR API response cache
data/cache/

# Timestamped scan outputs (local history only; deploy uses scan_latest.json + scan_partial.json)
data/scans/scan_v12_*.json
# Explicitly keep the two deploy-tracked files
!data/scans/scan_latest.json
!data/scans/scan_partial.json

# Scanner run artifacts
data/scans/legacy/
data/live_monitoring/runs/
data/live_monitoring/*.log
data/live_monitoring/*.csv
data/live_monitoring/latest_alerts.json
data/live_monitoring/latest_review_memo.md
data/live_monitoring/live_scanner_state.json
data/live_monitoring/source_pull_cache/
*.tmp

# Legacy scan outputs
data/legacy-scans/
data/predictions/
data/tracking/

# Historical case source text cache (local support material)
data/historical_cases/source_text_cache/

# AI research layer outputs (local-only; never commit generated research files or watchlist)
data/ai_research/

# Local VPS deploy config (contains host/credentials)
deploy/local/.env.deploy
!deploy/local/.env.deploy.example
